// BAKERY ERP - Schema completo de gestão de padarias
// SQLite + Prisma Client | Modelos planos (ids como string, sem FK estrita)
// para simplificar transações e evitar joins aninhados desnecessários.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ CATÁLOGO ============

model Category {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String   @id @default(cuid())
  name       String
  categoryId String?
  unit       String   @default("UN") // UN | KG
  price      Float    @default(0)
  cost       Float    @default(0)
  barcode    String?
  byWeight   Boolean  @default(false)
  isKitchen  Boolean  @default(true) // passa pelo KDS/produção
  ncm        String?  // NCM fiscal (padrão da padaria quando nulo)
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ INSUMOS / ESTOQUE ============

model Ingredient {
  id           String   @id @default(cuid())
  name         String
  unit         String   @default("KG") // KG | G | L | ML | UN | PCT
  costPerUnit  Float    @default(0)
  stock        Float    @default(0)
  minStock     Float    @default(0)
  supplierId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockMovement {
  id           String   @id @default(cuid())
  itemType     String   @default("INGREDIENT") // INGREDIENT | PRODUCT
  ingredientId String?
  productId    String?
  type         String   @default("ENTRADA") // ENTRADA | SAIDA | AJUSTE | PERDA | PRODUCAO | VENDA
  qty          Float
  unitCost     Float?
  reason       String?
  refId        String?  // id da OP, compra, venda etc.
  createdAt    DateTime @default(now())
}

// ============ RECEITAS / PRODUÇÃO ============

model Recipe {
  id        String       @id @default(cuid())
  name      String
  productId String?
  yieldQty  Float        @default(1) // rendimento
  unit      String       @default("UN")
  laborCost Float        @default(0) // custo de mão de obra/energia por lote
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     RecipeItem[] // declarativo; Prisma gera FK automática
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  qty          Float
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model ProductionOrder {
  id          String    @id @default(cuid())
  code        String
  recipeId    String
  recipeName  String
  plannedQty  Float
  producedQty Float?
  status      String    @default("PLANEJADA") // PLANEJADA | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  operator    String?
  notes       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ============ COMPRAS ============

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  items     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id         String         @id @default(cuid())
  code       String
  supplierId String
  supplier   String
  status     String         @default("PENDENTE") // PENDENTE | RECEBIDA | CANCELADA
  total      Float          @default(0)
  notes      String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  items      PurchaseItem[] // declarativo
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  ingredientId String
  name         String
  unit         String
  qty          Float
  unitCost     Float
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

// ============ CLIENTES ============

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  address       String?
  birthday      String?
  points        Int      @default(0)
  creditBalance Float    @default(0) // fiado acumulado
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ FUNCIONÁRIOS / RH ============

model Employee {
  id        String    @id @default(cuid())
  name      String
  role      String    @default("ATENDENTE") // PROPRIETARIO | GERENTE | CAIXA | PADEIRO | ATENDENTE | FINANCEIRO | ESTOQUISTA
  salary    Float     @default(0)
  phone     String?
  hiredAt   DateTime  @default(now())
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  logs      TimeLog[] // declarativo
}

model TimeLog {
  id         String   @id @default(cuid())
  employeeId String
  checkIn    DateTime
  checkOut   DateTime?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============ CAIXA ============

model CashSession {
  id             String    @id @default(cuid())
  operatorName   String
  openingBalance Float     @default(0)
  closingBalance Float?
  expectedBalance Float?
  status         String    @default("ABERTO") // ABERTO | FECHADO
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
}

model CashMovement {
  id          String   @id @default(cuid())
  sessionId   String
  type        String   @default("VENDA") // VENDA | SANGRIA | SUPRIMENTO | AJUSTE
  method      String?  // forma de pagamento quando VENDA
  amount      Float
  description String?
  refId       String?
  createdAt   DateTime @default(now())
}

// ============ VENDAS (PDV) ============

model Sale {
  id         String        @id @default(cuid())
  code       String
  customerId String?
  customer   String?
  sessionId  String?
  total      Float         @default(0)
  discount   Float         @default(0)
  status     String        @default("CONCLUIDA") // CONCLUIDA | CANCELADA
  channel    String        @default("BALCAO") // BALCAO | ENCOMENDA | DELIVERY
  operator   String?
  createdAt  DateTime      @default(now())
  items      SaleItem[]    // declarativo
  payments   SalePayment[] // declarativo
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  name      String
  qty       Float
  unitPrice Float
  unit      String @default("UN")
  subtotal  Float
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SalePayment {
  id      String @id @default(cuid())
  saleId  String
  method  String // DINHEIRO | PIX | DEBITO | CREDITO | VALE | FIADO
  amount  Float
  sale    Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// ============ PEDIDOS (KDS) ============

model Order {
  id           String     @id @default(cuid())
  code         String
  customerName String?
  phone        String?
  source       String     @default("PDV") // PDV | ENCOMENDA | DELIVERY | WHATSAPP
  status       String     @default("AGUARDANDO") // AGUARDANDO | PREPARANDO | PRONTO | ENTREGUE | CANCELADO
  notes        String?
  expectedAt   DateTime?
  saleId       String?
  startedAt    DateTime?
  readyAt      DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime   @default(now())
  items        OrderItem[] // declarativo
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  qty       Float
  notes     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============ FINANCEIRO ============

model Payable {
  id          String    @id @default(cuid())
  description String
  supplierId  String?
  supplier    String?
  category    String?   // INSUMOS | FOLHA | ALUGUEL | ENERGIA | TAXAS | OUTROS
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | PAGO
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Receivable {
  id          String    @id @default(cuid())
  description String
  customerId  String?
  customer    String?
  saleId      String?
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | RECEBIDO
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   @default("RECEITA") // RECEITA | DESPESA
  category    String?  // VENDAS | INSUMOS | FOLHA | ALUGUEL | ENERGIA | TAXAS | OUTROS
  description String
  amount      Float
  method      String?
  refId       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ============ PAGAMENTOS (MERCADO PAGO) ============

model Payment {
  id         String    @id @default(cuid())
  provider   String    @default("MERCADOPAGO")
  externalId String?
  method     String    @default("PIX") // PIX | CREDITO | DEBITO
  amount     Float
  fee        Float     @default(0)
  netAmount  Float     @default(0)
  status     String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  pixCode    String?
  qrImageUrl String?
  description String?
  saleId     String?
  orderId    String?
  customerId String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
}

// ============ AUDITORIA / ALERTAS ============

model AuditLog {
  id        String   @id @default(cuid())
  actor     String?
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO | WARNING | CRITICAL
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ DELIVERY ============

model Deliverer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  vehicle   String?  // Moto | Bicicleta | Carro
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   // bairro / região
  fee       Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Delivery {
  id            String    @id @default(cuid())
  code          String    @unique
  orderId       String?
  customerName  String?
  phone         String?
  address       String?
  zoneId        String?
  zoneName      String?
  delivererId   String?
  delivererName String?
  fee           Float     @default(0)
  status        String    @default("PENDENTE") // PENDENTE | EM_ROTA | ENTREGUE | FALHOU
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ ENCOMENDAS ============

model Booking {
  id           String    @id @default(cuid())
  code         String    @unique
  customerName String
  phone        String?
  kind         String    @default("BOLO") // BOLO | FESTA | SALGADOS | OUTROS
  description  String
  serveQty     Float?    // rendimento / nº de pessoas
  dueDate      DateTime  // data e horário de retirada
  totalAmount  Float     @default(0)
  deposit      Float     @default(0) // sinal pago
  status       String    @default("ORCAMENTO") // ORCAMENTO | CONFIRMADA | EM_PRODUCAO | PRONTA | RETIRADA | CANCELADA
  notes        String?   // ficha de produção específica
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============ ACESSOS / AUTENTICAÇÃO / PERMISSÕES (Fase 3) ============

// Empresas (multi-tenant) e unidades (filiais)
model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  cnpj      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches    Branch[]
  memberships UserMembership[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accesses  UserBranchAccess[]
}

// Perfis de acesso (modelos reutilizáveis de permissões)
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // código interno, ex: PROPRIETARIO
  description String?
  isSystem    Boolean  @default(false) // perfil de sistema (não pode excluir)
  isAbsolute  Boolean  @default(false) // Proprietário: privilégios absolutos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id            String @id @default(cuid())
  roleId        String
  permissionKey String // chave estável do catálogo, ex: sales.cancel
  role          Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
}

// Usuários individuais (e-mail = identificador de login)
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  phone              String?
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED
  mustChangePassword Boolean   @default(false)
  roleId             String
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role               Role      @relation(fields: [roleId], references: [id])
  credential         Credential?
  sessions           Session[]
  overrides          UserPermissionOverride[]
  memberships        UserMembership[]
  branchAccess       UserBranchAccess[]
  resetTokens        PasswordResetToken[]
}

// Credenciais (hash Argon2id - nunca texto puro)
model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  algorithm    String   @default("ARGON2ID")
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sessões ativas (token opaco; apenas o hash é armazenado)
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  active     Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Vínculo usuário ↔ empresa
model UserMembership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// Vínculo usuário ↔ unidade autorizada
model UserBranchAccess {
  id       String @id @default(cuid())
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

// Personalizações individuais (overrides sobre o perfil)
// granted=true => permissão extra; granted=false => restrição (prevalece sobre o perfil)
model UserPermissionOverride {
  id            String    @id @default(cuid())
  userId        String
  permissionKey String
  granted       Boolean
  origin        String    @default("INDIVIDUAL") // INDIVIDUAL | TEMPORARY
  grantedBy     String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
}

// Tokens de recuperação de senha (validade curta + uso único)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auditoria de acessos e operações administrativas
model AccessLog {
  id        String   @id @default(cuid())
  actor     String?  // nome do responsável
  userId    String?
  userEmail String?
  action    String   // LOGIN_OK | LOGIN_FAILED | LOGOUT | ...
  result    String   @default("SUCCESS") // SUCCESS | FAILURE
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ============ QUALIDADE / DESPERDÍCIO ============

model WasteRecord {
  id           String    @id @default(cuid())
  itemType     String    @default("PRODUCT") // PRODUCT | INGREDIENT
  productId    String?
  ingredientId String?
  name         String
  qty          Float     @default(0)
  unit         String?
  reason       String    @default("OUTROS") // VENCIDO | QUEIMADO | ERRO_PRODUCAO | DEVOLUCAO | OUTROS
  cost         Float     @default(0)
  actor        String?
  notes        String?
  createdAt    DateTime  @default(now())
}

// ============ MOTOR FISCAL (Fase 4 - Etapa 06) ============
// Camada Fiscal Engine: NFC-e 65, NF-e 55, tabelas tributárias versionadas
// (Reforma Tributária: IBS/CBS), contingência, cancelamento e inutilização.

// Configuração do emissor fiscal da empresa (1 linha ativa)
model FiscalConfig {
  id             String   @id @default(cuid())
  companyName    String   // razão social emitente
  cnpj           String   @unique
  ie             String?  // inscrição estadual (isento quando "ISENTO")
  uf             String   @default("SP")
  crt            String   @default("SIMPLES_NACIONAL") // SIMPLES_NACIONAL | LUCRO_REAL | LUCRO_PRESUMIDO
  environment    String   @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO
  provider       String   @default("LOCAL_SIMULADO") // provedor fiscal plugável (interface)
  nfceSeries     Int      @default(1)
  nfceNextNumber Int      @default(1)
  nfeSeries      Int      @default(1)
  nfeNextNumber  Int      @default(1)
  autoEmit       Boolean  @default(false) // emite NFC-e automaticamente no checkout do PDV
  // Contingência (off-line): mantém numeração local até retorno do SEFAZ
  contingency    Boolean  @default(false)
  contingencyReason String?
  contingencySince  DateTime?
  // Certificado digital A1 (metadados; arquivo PFX não fica no banco)
  certA1Name     String?
  certA1Expires  DateTime?
  certA1Status   String   @default("MISSING") // MISSING | VALID | EXPIRING | EXPIRED
  // Versão corrente da tabela tributária (Notas Técnicas versionadas)
  taxVersion     String   @default("2026.1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Tabelas tributárias versionadas (NCM, CFOP, CSOSN/CST, ICMS, IBS, CBS)
// Não são codificadas nas regras comerciais: atualizações independentes por versão.
model TaxTable {
  id            String   @id @default(cuid())
  version       String   @default("2026.1") // versão das NTs (ex: 2026.1 reforma IBS/CBS)
  ncm           String   // 8 dígitos
  description   String
  cfop          String   @default("5102") // operação interna venda de mercadoria
  origin        String   @default("0") // 0 nacional...
  csosn         String   @default("102") // SIMPLES: 102/103/400/500; REGIME NORMAL: CST
  cst           String?  // usado em LUCRO_REAL/PRESUMIDO
  icmsRate      Float    @default(0)
  pisRate       Float    @default(0)
  cofinsRate    Float    @default(0)
  ibsRate       Float    @default(0)   // reforma tributária 2026
  cbsRate       Float    @default(0)   // reforma tributária 2026
  reducedIbs    Boolean  @default(false) // redutor/cesta básica nacional
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([version, ncm, cfop])
}

// Documento fiscal emitido (NFC-e modelo 65 ou NF-e modelo 55)
model FiscalDocument {
  id            String    @id @default(cuid())
  type          String    @default("NFCE") // NFCE (modelo 65) | NFE (modelo 55)
  serie         Int
  number        Int
  accessKey     String    @unique // 44 dígitos, dígito verificador calculado
  saleId        String?   // origem PDV (opcional)
  saleCode      String?
  // Valores (snapshot da venda, em R$)
  productsTotal Float     @default(0)
  discount      Float     @default(0)
  icmsTotal     Float     @default(0)
  ibsTotal      Float     @default(0)
  cbsTotal      Float     @default(0)
  total         Float     @default(0)
  // Emitente e destinatário
  issuerName    String
  issuerCnpj    String
  customerName  String?
  customerDoc   String?   // CPF/CNPJ do destinatário (obrigatório em NF-e)
  customerAddress String?
  // Transmissão
  status        String    @default("PENDENTE") // PENDENTE | CONTINGENCIA | TRANSMITIDA | REJEITADA | CANCELADA | INUTILIZADA
  environment   String    @default("HOMOLOGACAO")
  contingency   Boolean   @default(false)
  protocol      String?
  receivedAt    DateTime?
  rejectCode    String?
  rejectMessage String?
  attempts      Int       @default(0)
  xml           String?   // XML da autorização armazenado (recuperável)
  danfeMeta     String?   // metadados do DANFE (JSON)
  operator      String?   // usuário responsável pela emissão
  issuedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  events        FiscalEvent[] // declarativo
}

// Histórico de eventos fiscais (emissão, autorização, rejeições, reenvios,
// cancelamento, inutilização, contingência) - trilha auditável por documento
model FiscalEvent {
  id         String   @id @default(cuid())
  documentId String?
  type       String   // EMISSAO | AUTORIZACAO | REJEICAO | REENVIO | CANCELAMENTO | INUTILIZACAO | CONTINGENCIA_ON | CONTINGENCIA_OFF | NUMERACAO
  accessKey  String?
  description String
  author     String?
  createdAt  DateTime @default(now())
  document   FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
